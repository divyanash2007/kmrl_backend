# ==========================================
# CiviSeva Backend Environment Configuration
# ==========================================

# Database: Supabase PostgreSQL Connection URL
# For Supabase Session Pooler (IPv4 compatible):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Or Direct Connection:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# For Local Dev:
DATABASE_URL=sqlite:///./civiseva.db

# Official Authentication Passphrase
SAFE_KEY=KMRL-SECURE-2026

# Google Gemini API Key for Grounded RAG Guidance
GOOGLE_API_KEY=your_gemini_api_key_here

# Relative Paths to ML Model & Vector Store (bundled inside backend/data)
KMRL_MODEL_PATH=data/model/document_classifier.joblib
KMRL_CHROMA_PATH=data/chroma_db

# Allowed CORS Origins (Include your Railway frontend URL in production)
# Example: https://civiseva-frontend.up.railway.app,http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","*"]

